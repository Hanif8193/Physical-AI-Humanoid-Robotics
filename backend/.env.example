# Physical AI & Humanoid Robotics — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ─── Groq (LLM for RAG, translation, personalization) ───────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
CHAT_MODEL=llama-3.3-70b-versatile

# ─── Qdrant Cloud (vector database) ─────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=textbook_chunks

# ─── Embedding Model (local, no API key needed) ─────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMS=384

# ─── Database (Neon Serverless Postgres) ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Auth ────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your_random_32_char_secret_here
BETTER_AUTH_URL=http://localhost:8000
ADMIN_API_KEY=your_admin_api_key_here

# ─── CORS (comma-separated frontend URLs) ───────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-org.github.io
